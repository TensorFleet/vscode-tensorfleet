{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "sourceMap": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "baseUrl": ".",

    "paths": {
      "@/*": ["./src/*"],

      // Generic mapping for ALL @lichtblick/* packages
      // @lichtblick/log            -> packages/log/src
      // @lichtblick/suite-base     -> packages/suite-base/src
      // @lichtblick/mcap-support   -> packages/mcap-support/src
      // etc.
      "@lichtblick/*": ["./packages/*/src"],

      // Local @types/*
      "@types/*": ["./packages/@types/*"],

      "tensorfleet-util": ["./packages/tensorfleet-util/src/index.ts"],
      "tensorfleet-util/*": ["./packages/tensorfleet-util/src/*"]
    }
  },

  "include": [
    "src",
    "packages/**/*.ts",
    "packages/**/*.tsx"
, "shared/ros-util", "packages/tensorfleet-util"  ],

  "references": [
    { "path": "./tsconfig.node.json" }
  ]
}
