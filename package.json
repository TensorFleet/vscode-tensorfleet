{
  "name": "tensorfleet-drone",
  "displayName": "TensorFleet Robots and Drone Environment",
  "description": "Flexible drone operations workspace for TensorFleet with multi-view dashboards and tooling management.",
  "version": "0.1.0",
  "publisher": "tensorfleet",
  "homepage": "https://tensorfleet.net/",
  "repository": {
    "type": "git",
    "url": "https://github.com/TensorFleet/vscode-tensorfleet.git"
  },
  "icon": "media/store-icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:tensorfleet-gzweb-panel",
    "onView:tensorfleet-aiops",
    "onView:tensorfleet-ros2-baselines",
    "onView:tensorfleet-image-panel",
    "onView:tensorfleet-teleops-panel",
    "onView:tensorfleet-map-panel",
    "onView:tensorfleet-raw-messages-panel",
    "onView:tensorfleet-tooling-view",
    "onCommand:tensorfleet.openGzWebPanel",
    "onCommand:tensorfleet.openAIPanel",
    "onCommand:tensorfleet.openROS2Panel",
    "onCommand:tensorfleet.openImagePanel",
    "onCommand:tensorfleet.openTeleopsPanel",
    "onCommand:tensorfleet.openMapPanel",
    "onCommand:tensorfleet.openVacuumControlPanel",
    "onCommand:tensorfleet.openNav2Panel",
    "onCommand:tensorfleet.openRawMessagesPanel",
    "onCommand:tensorfleet.openFeaturedEntitiesPanel",
    "onCommand:tensorfleet.createNewProject",
    "onCommand:tensorfleet.createNewRoboticArmProject",
    "onCommand:tensorfleet.installTools",
    "onCommand:tensorfleet.openAllPanels",
    "onCommand:tensorfleet.startMCPServer",
    "onCommand:tensorfleet.stopMCPServer",
    "onCommand:tensorfleet.getMCPConfig",
    "onCommand:tensorfleet.selectRosVersion",
    "onCommand:tensorfleet.showVMManagerMenu",
    "onCommand:tensorfleet.showDroneStatus",
    "onCommand:tensorfleet.selectRegion",
    "onCommand:tensorfleet.showUnifiedMenu",
    "onCommand:tensorfleet.login"
  ],
  "main": "./dist/extension.js",
  "packageManager": "bun@1.0.0",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tensorfleet-drone-suite",
          "title": "TensorFleet",
          "icon": "media/tensorfleet-icon.svg"
        }
      ]
    },
    "views": {
      "tensorfleet-drone-suite": [
        {
          "id": "tensorfleet-account",
          "name": "Account",
          "type": "webview",
          "when": "(!tensorfleet.is_authenticated && tensorfleet.current_panel != 'help') || tensorfleet.current_panel == 'account'"
        },
        {
          "id": "tensorfleet-server-settings",
          "name": "Virtual machine settings",
          "type": "webview",
          "when": "tensorfleet.is_authenticated && (tensorfleet.current_panel == 'server-settings')"
        },
        {
          "id": "tensorfleet-drone-view-list",
          "name": "Drone and ROS Views",
          "type": "webview",
          "when": "tensorfleet.is_authenticated && (tensorfleet.current_panel == '')"
        },
        {
          "id": "tensorfleet-help-panel",
          "name": "Help",
          "type": "webview",
          "when": "(tensorfleet.current_panel == 'help')"
        },
        {
          "id": "tensorfleet-tooling-view",
          "name": "Tool Installer",
          "type": "webview",
          "when": "tensorfleet.current_panel == 'tooling'"
        }
      ]
    },
    "commands": [
      {
        "command": "tensorfleet.createNewProject",
        "title": "Create new tensorfleet project",
        "category": "Tensorfleet",
        "icon": "$(plus)"
      },
      {
        "command": "tensorfleet.createNewRoboticArmProject",
        "title": "Create new LeRobot arm project",
        "category": "Tensorfleet",
        "icon": "$(plus)"
      },
      {
        "command": "tensorfleet.openDroneViewsPanel",
        "title": "Open drone views",
        "category": "Tensorfleet",
        "icon": "media/tensorfleet-icon.svg"
      },
      {
        "command": "tensorfleet.openServerSettingsPanel",
        "title": "Open server settings",
        "category": "Tensorfleet",
        "icon": "$(server-environment)"
      },
      {
        "command": "tensorfleet.openHelpPanel",
        "title": "Open Help Panel",
        "category": "Tensorfleet",
        "icon": "$(question)"
      },
      {
        "command": "tensorfleet.openAccountPanel",
        "title": "Toggle Account Panel",
        "category": "TensorFleet",
        "icon": {
          "light": "media/avatar_outline.svg",
          "dark": "media/avatar_outline.svg"
        }
      },
      {
        "command": "tensorfleet.openGzWebPanel",
        "title": "TensorFleet: Open Simulation View",
        "category": "TensorFleet"
      },
      {
        "command": "tensorfleet.openAIPanel",
        "title": "TensorFleet: Open AI Ops Workspace",
        "category": "TensorFleet"
      },
      {
        "command": "tensorfleet.openROS2Panel",
        "title": "Open ROS 2 & Stable Baselines Lab",
        "category": "TensorFleet"
      },
      {
        "command": "tensorfleet.openImagePanel",
        "title": "Open Image Panel",
        "category": "TensorFleet"
      },
      {
        "command": "tensorfleet.openTeleopsPanel",
        "title": "Open Teleops Panel",
        "category": "TensorFleet"
      },
      {
        "command": "tensorfleet.openMapPanel",
        "title": "Open Map Panel",
        "category": "TensorFleet"
      },
      {
        "command": "tensorfleet.openVacuumControlPanel",
        "title": "Open Vacuum Control Panel",
        "category": "TensorFleet"
      },
      {
        "command": "tensorfleet.openNav2Panel",
        "title": "Open Nav2 Panel",
        "category": "TensorFleet"
      },
      {
        "command": "tensorfleet.openRawMessagesPanel",
        "title": "Open Raw Messages Panel",
        "category": "TensorFleet"
      },
      {
        "command": "tensorfleet.openFeaturedEntitiesPanel",
        "title": "TensorFleet: Open Featured Entities Panel",
        "category": "TensorFleet"
      },
      {
        "command": "tensorfleet.installTools",
        "title": "Install Bundled Tools",
        "category": "TensorFleet"
      },
      {
        "command": "tensorfleet.openAllPanels",
        "title": "Open All Dashboards in Main Area",
        "category": "TensorFleet"
      },
      {
        "command": "tensorfleet.startMCPServer",
        "title": "Start MCP Server (for Cursor/Claude)",
        "category": "TensorFleet"
      },
      {
        "command": "tensorfleet.stopMCPServer",
        "title": "Stop MCP Server",
        "category": "TensorFleet"
      },
      {
        "command": "tensorfleet.getMCPConfig",
        "title": "Show MCP Configuration",
        "category": "TensorFleet"
      },
      {
        "command": "tensorfleet.selectRosVersion",
        "title": "Select ROS Version",
        "category": "TensorFleet"
      },
      {
        "command": "tensorfleet.showDroneStatus",
        "title": "Show Drone Status",
        "category": "TensorFleet"
      },
      {
        "command": "tensorfleet.showVMManagerMenu",
        "title": "Show VM Actions",
        "category": "TensorFleet"
      },
      {
        "command": "tensorfleet.showUnifiedMenu",
        "title": "TensorFleet: Show Status Menu",
        "category": "TensorFleet"
      },
      {
        "command": "tensorfleet.login",
        "title": "TensorFleet: Login",
        "category": "TensorFleet"
      },
      {
        "command": "tensorfleet.logout",
        "title": "TensorFleet: Logout",
        "category": "TensorFleet"
      },
      {
        "command": "tensorfleet.authStatus",
        "title": "TensorFleet: Show Auth Status",
        "category": "TensorFleet"
      },
      {
        "command": "tensorfleet.openToolsPanel",
        "title": "Open Tools Panel",
        "category": "TensorFleet",
        "icon": "media/tools-icon.png"
      },
      {
        "command": "tensorfleet.selectRegion",
        "title": "Select Region",
        "category": "TensorFleet"
      }
    ],
    "configuration": {
      "title": "TensorFleet",
      "properties": {
        "tensorfleet.region": {
          "type": "string",
          "default": "eu",
          "enum": [
            "eu",
            "asia",
            "local"
          ],
          "enumDescriptions": [
            "EU  - Europe Central Region (eu.vm.tensorfleet.net)",
            "Asia - Southeast Region (asia.vm.tensorfleet.net)",
            "Local - Development only (hidden in production builds)"
          ],
          "description": "Select your TensorFleet region for VM and API access.",
          "order": 1
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "tensorfleet.openAccountPanel",
          "group": "navigation@2",
          "when": "(view == tensorfleet-account || view == tensorfleet-server-settings || view == tensorfleet-drone-view-list || view == tensorfleet-help-panel || view == tensorfleet-tooling-view)"
        },
        {
          "command": "tensorfleet.openDroneViewsPanel",
          "group": "navigation@1",
          "when": "tensorfleet.is_authenticated && (view == tensorfleet-account || view == tensorfleet-server-settings || view == tensorfleet-drone-view-list || view == tensorfleet-help-panel || view == tensorfleet-tooling-view)"
        },
        {
          "command": "tensorfleet.openServerSettingsPanel",
          "group": "navigation@1",
          "when": "tensorfleet.is_authenticated && (view == tensorfleet-account || view == tensorfleet-server-settings || view == tensorfleet-drone-view-list || view == tensorfleet-help-panel || view == tensorfleet-tooling-view)"
        },
        {
          "command": "tensorfleet.openHelpPanel",
          "group": "navigation@3",
          "when": "(view == tensorfleet-account || view == tensorfleet-server-settings || view == tensorfleet-drone-view-list || view == tensorfleet-help-panel || view == tensorfleet-tooling-view)"
        },
        {
          "command": "tensorfleet.openToolsPanel",
          "group": "navigation@0.5",
          "when": "(view == tensorfleet-account || view == tensorfleet-drone-view-list || view == tensorfleet-help-panel || view == tensorfleet-tooling-view || view == tensorfleet-server-settings) && tensorfleet.is_authenticated"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "bun run compile",
    "sync:panels-deps": "BUN_TMPDIR=/tmp BUN_INSTALL=/tmp/bun-tensorfleet bun install --frozen-lockfile --linker hoisted && BUN_TMPDIR=/tmp BUN_INSTALL=/tmp/bun-tensorfleet bun install --cwd panels-standalone --frozen-lockfile --linker isolated",
    "prepare:telemetry": "bun scripts/write-telemetry-config.ts",
    "build:panels": "bun run --cwd panels-standalone build",
    "watch:panels": "bun run --cwd panels-standalone build --watch",
    "build:extension": "bun run prepare:telemetry && vite build",
    "watch:extension": "bun run prepare:telemetry && vite build --watch",
    "compile": "bun run build:panels && bun run build:extension",
    "compile:dev": "TENSORFLEET_BUILD=development bun run compile",
    "compile:prod": "TENSORFLEET_BUILD=production bun run compile",
    "watch": "bun run sync:panels-deps && (TENSORFLEET_BUILD=development bun run watch:panels & TENSORFLEET_BUILD=development bun run watch:extension & wait)",
    "test:vacuum-adapter": "bun scripts/vacuum-adapter-regression.ts",
    "typecheck": "bunx tsc -p ./ --noEmit",
    "lint": "bunx eslint src --ext ts",
    "package": "bunx vsce package",
    "package:dev": "TENSORFLEET_BUILD=development bun run compile && bunx vsce package",
    "mcp": "node dist/mcp-server.js",
    "version:get": "bun scripts/get-version.ts"
  },
  "bin": {
    "tensorfleet-mcp": "./dist/mcp-server.js"
  },
  "dependencies": {
    "@foxglove/schemas": "^1.8.0",
    "@foxglove/ws-protocol": "^0.8.0",
    "@lichtblick/message-definition": "^1.0.0",
    "@lichtblick/omgidl-parser": "^1.0.0",
    "@lichtblick/omgidl-serialization": "^1.0.0",
    "@lichtblick/ros2idl-parser": "^1.0.0",
    "@lichtblick/rosmsg": "^1.0.0",
    "@lichtblick/rosmsg-msgs-common": "^1.0.1",
    "@lichtblick/rosmsg-serialization": "^1.0.0",
    "@lichtblick/rosmsg2-serialization": "^1.0.0",
    "@lichtblick/wasm-bz2": "^1.0.0",
    "@lichtblick/wasm-lz4": "^1.0.0",
    "@lichtblick/wasm-zstd": "^1.0.0",
    "@mcap/core": "^2.1.7",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@protobufjs/base64": "^1.1.2",
    "@sentry/node": "^10.26.0",
    "flatbuffers": "^25.9.23",
    "flatbuffers_reflection": "^1.2.0",
    "jpeg-js": "^0.4.4",
    "protobufjs": "^7.5.4",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^18.17.0",
    "@types/vscode": "^1.85.0",
    "eslint": "^8.56.0",
    "tslib": "^2.6.2",
    "typescript": "^5.2.2",
    "vite": "^5.4.2"
  }
}
