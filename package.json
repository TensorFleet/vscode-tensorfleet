{
  "name": "tensorfleet-drone",
  "displayName": "TensorFleet Robots and Drone Environment",
  "description": "Flexible drone operations workspace for TensorFleet with multi-view dashboards and tooling management.",
  "version": "0.1.0",
  "publisher": "tensorfleet",
  "homepage": "https://tensorfleet.net/",
  "repository": {
    "type": "git",
    "url": "https://github.com/TensorFleet/vscode-tensorfleet.git"
  },
  "icon": "media/store-icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:tensorfleet-gazebo",
    "onView:tensorfleet-aiops",
    "onView:tensorfleet-ros2-baselines",
    "onView:tensorfleet-image-panel",
    "onView:tensorfleet-teleops-panel",
    "onView:tensorfleet-map-panel",
    "onView:tensorfleet-raw-messages-panel",
    "onView:tensorfleet-tooling-view",
    "onCommand:tensorfleet.openGazeboPanel",
    "onCommand:tensorfleet.openAIPanel",
    "onCommand:tensorfleet.openROS2Panel",
    "onCommand:tensorfleet.openImagePanel",
    "onCommand:tensorfleet.openTeleopsPanel",
    "onCommand:tensorfleet.openMapPanel",
    "onCommand:tensorfleet.openRawMessagesPanel",
    "onCommand:tensorfleet.createNewProject",
    "onCommand:tensorfleet.installTools",
    "onCommand:tensorfleet.openAllPanels",
    "onCommand:tensorfleet.startMCPServer",
    "onCommand:tensorfleet.stopMCPServer",
    "onCommand:tensorfleet.getMCPConfig",
    "onCommand:tensorfleet.selectRosVersion",
    "onCommand:tensorfleet.showDroneStatus",
    "onCommand:tensorfleet.showVMManagerMenu"
  ],
  "main": "./dist/extension.js",
  "packageManager": "bun@1.0.0",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tensorfleet-drone-suite",
          "title": "TensorFleet",
          "icon": "media/tensorfleet-icon.svg"
        }
      ],
      "panel": [
        {
          "id": "tensorfleet-tooling",
          "title": "TensorFleet Tools",
          "icon": "media/tensorfleet-icon.svg"
        }
      ]
    },
    "views": {
      "tensorfleet-drone-suite": [
        {
          "id": "tensorfleet-login",
          "name": "Account",
          "type": "webview",
          "when": "!tensorfleet.is_authenticated"
        },
        {
          "id": "tensorfleet-account",
          "name": "Account",
          "type": "webview",
          "when": "tensorfleet.is_authenticated"
        },
        {
          "id": "tensorfleet-map-panel",
          "name": "Map Panel",
          "type": "webview",
          "when": "tensorfleet.is_authenticated"
        },
        {
          "id": "tensorfleet-view-3d",
          "name": "3D Views",
          "type": "webview",
          "when": "tensorfleet.is_authenticated"
        },
        {
          "id": "tensorfleet-image-panel",
          "name": "Image Panel",
          "type": "webview",
          "when": "tensorfleet.is_authenticated"
        },
        {
          "id": "tensorfleet-aiops",
          "name": "AI Ops",
          "type": "webview",
          "when": "tensorfleet.is_authenticated"
        },
        {
          "id": "tensorfleet-ros2-baselines",
          "name": "ROS 2 & Stable Baselines",
          "type": "webview",
          "when": "tensorfleet.is_authenticated"
        },
        {
          "id": "tensorfleet-teleops-panel",
          "name": "Teleops Panel",
          "type": "webview",
          "when": "tensorfleet.is_authenticated"
        },
        {
          "id": "tensorfleet-raw-messages-panel",
          "name": "Raw Messages Panel",
          "type": "webview",
          "when": "tensorfleet.is_authenticated"
        }
      ],
      "tensorfleet-tooling": [
        {
          "id": "tensorfleet-tooling-view",
          "name": "Tool Installer",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "tensorfleet.openGazeboPanel",
        "title": "Open Gazebo Workspace",
        "category": "TensorFleet"
      },
      {
        "command": "tensorfleet.openAIPanel",
        "title": "Open AI Ops Workspace",
        "category": "TensorFleet"
      },
      {
        "command": "tensorfleet.openROS2Panel",
        "title": "Open ROS 2 & Stable Baselines Lab",
        "category": "TensorFleet"
      },
      {
        "command": "tensorfleet.openImagePanel",
        "title": "Open Image Panel",
        "category": "TensorFleet"
      },
      {
        "command": "tensorfleet.openTeleopsPanel",
        "title": "Open Teleops Panel",
        "category": "TensorFleet"
      },
      {
        "command": "tensorfleet.openMapPanel",
        "title": "Open Map Panel",
        "category": "TensorFleet"
      },
      {
        "command": "tensorfleet.openRawMessagesPanel",
        "title": "Open Raw Messages Panel",
        "category": "TensorFleet"
      },
      {
        "command": "tensorfleet.createNewProject",
        "title": "Create New Project",
        "category": "TensorFleet"
      },
      {
        "command": "tensorfleet.installTools",
        "title": "Install Bundled Tools",
        "category": "TensorFleet"
      },
      {
        "command": "tensorfleet.openAllPanels",
        "title": "Open All Dashboards in Main Area",
        "category": "TensorFleet"
      },
      {
        "command": "tensorfleet.startMCPServer",
        "title": "Start MCP Server (for Cursor/Claude)",
        "category": "TensorFleet"
      },
      {
        "command": "tensorfleet.stopMCPServer",
        "title": "Stop MCP Server",
        "category": "TensorFleet"
      },
      {
        "command": "tensorfleet.getMCPConfig",
        "title": "Show MCP Configuration",
        "category": "TensorFleet"
      },
      {
        "command": "tensorfleet.selectRosVersion",
        "title": "Select ROS Version",
        "category": "TensorFleet"
      },
      {
        "command": "tensorfleet.showDroneStatus",
        "title": "Show Drone Status",
        "category": "TensorFleet"
      },
      {
        "command": "tensorfleet.showVMManagerMenu",
        "title": "Show VM Actions",
        "category": "TensorFleet"
      },
      {
        "command": "tensorfleet.showUnifiedMenu",
        "title": "TensorFleet: Show Status Menu",
        "category": "TensorFleet"
      },
      {
        "command": "tensorfleet.login",
        "title": "TensorFleet: Login",
        "category": "TensorFleet"
      },
      {
        "command": "tensorfleet.logout",
        "title": "TensorFleet: Logout",
        "category": "TensorFleet"
      },
      {
        "command": "tensorfleet.authStatus",
        "title": "TensorFleet: Show Auth Status",
        "category": "TensorFleet"
      }
    ],
    "configuration": {
      "title": "TensorFleet",
      "properties": {
        "tensorfleet.ros2.websocketUrl": {
          "type": "string",
          "default": "ws://172.16.0.10:9091",
          "description": "ROS2 WebSocket URL (rosbridge_suite) for remote connections (e.g., Firecracker VM)",
          "pattern": "^(ws|wss)://.*$"
        },
        "tensorfleet.ros2.foxgloveUrl": {
          "type": "string",
          "default": "ws://172.16.0.10:8765",
          "description": "Foxglove Bridge WebSocket URL (high-performance C++ bridge) for remote ROS2 connections",
          "pattern": "^(ws|wss)://.*$"
        },
        "tensorfleet.backendUrl": {
          "type": "string",
          "default": "https://app.tensorfleet.net",
          "description": "Base URL for TensorFleet backend API (used for auth and data). Trailing slashes are removed.",
          "pattern": "^(http|https)://.*$"
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "tensorfleet.openGazeboPanel",
          "when": "view == tensorfleet-gazebo",
          "group": "navigation@1"
        },
        {
          "command": "tensorfleet.openAIPanel",
          "when": "view == tensorfleet-aiops",
          "group": "navigation@1"
        },
        {
          "command": "tensorfleet.openROS2Panel",
          "when": "view == tensorfleet-ros2-baselines",
          "group": "navigation@1"
        },
        {
          "command": "tensorfleet.openImagePanel",
          "when": "view == tensorfleet-image-panel",
          "group": "navigation@1"
        },
        {
          "command": "tensorfleet.openTeleopsPanel",
          "when": "view == tensorfleet-teleops-panel",
          "group": "navigation@1"
        },
        {
          "command": "tensorfleet.openRawMessagesPanel",
          "when": "view == tensorfleet-raw-messages-panel",
          "group": "navigation@1"
        },
        {
          "command": "tensorfleet.openAllPanels",
          "when": "view == tensorfleet-gazebo",
          "group": "navigation@9"
        },
        {
          "command": "tensorfleet.openAllPanels",
          "when": "view == tensorfleet-aiops",
          "group": "navigation@9"
        },
        {
          "command": "tensorfleet.openAllPanels",
          "when": "view == tensorfleet-ros2-baselines",
          "group": "navigation@9"
        },
        {
          "command": "tensorfleet.openAllPanels",
          "when": "view == tensorfleet-tooling-view",
          "group": "navigation@9"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "bun run compile",
    "prepare:telemetry": "bun scripts/write-telemetry-config.ts",
    "compile": "bun run prepare:telemetry && bunx vite build",
    "watch": "bun run prepare:telemetry && bunx vite build --watch",
    "typecheck": "bunx tsc -p ./ --noEmit",
    "lint": "bunx eslint src --ext ts",
    "package": "bunx vsce package",
    "mcp": "node dist/mcp-server.js",
    "version:get": "bun scripts/get-version.ts"
  },
  "bin": {
    "tensorfleet-mcp": "./dist/mcp-server.js"
  },
  "dependencies": {
    "@foxglove/schemas": "^1.8.0",
    "@foxglove/ws-protocol": "^0.8.0",
    "@lichtblick/message-definition": "^1.0.0",
    "@lichtblick/omgidl-parser": "^1.0.0",
    "@lichtblick/omgidl-serialization": "^1.0.0",
    "@lichtblick/ros2idl-parser": "^1.0.0",
    "@lichtblick/rosmsg": "^1.0.0",
    "@lichtblick/rosmsg-msgs-common": "^1.0.1",
    "@lichtblick/rosmsg-serialization": "^1.0.0",
    "@lichtblick/rosmsg2-serialization": "^1.0.0",
    "@lichtblick/wasm-bz2": "^1.0.0",
    "@lichtblick/wasm-lz4": "^1.0.0",
    "@lichtblick/wasm-zstd": "^1.0.0",
    "@mcap/core": "^2.1.7",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@protobufjs/base64": "^1.1.2",
    "@sentry/node": "^10.26.0",
    "flatbuffers": "^25.9.23",
    "flatbuffers_reflection": "^1.2.0",
    "jpeg-js": "^0.4.4",
    "protobufjs": "^7.5.4"
  },
  "devDependencies": {
    "@types/node": "^18.17.0",
    "@types/vscode": "^1.85.0",
    "eslint": "^8.56.0",
    "tslib": "^2.6.2",
    "typescript": "^5.2.2",
    "vite": "^5.4.2"
  }
}
