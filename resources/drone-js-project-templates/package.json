{
  "name": "tensorfleet-drone-js-project",
  "version": "0.0.1",
  "private": true,
  "description": "TensorFleet drone starter using JavaScript and roslib over rosbridge.",
  "type": "module",
  "engines": {
    "node": ">=14.0.0",
    "bun": ">=1.0.0"
  },
  "scripts": {
    "check": "node check-runtime.js",
    "restart": "bun src/restart_sim.js",
    "drone:mover": "bun src/drone_mover.js",
    "vision:yolo": "bun src/vision_yolo.js",
    "vision:landing": "bun src/visual_landing.js",
    "tutorial:01": "bun src/tutorials/01_connect.js",
    "tutorial:02": "bun src/tutorials/02_telemetry.js",
    "tutorial:03": "bun src/tutorials/03_arm.js",
    "tutorial:04": "bun src/tutorials/04_takeoff_land.js",
    "tutorial:05": "bun src/tutorials/05_offboard_hover.js",
    "tutorial:06": "bun src/tutorials/06_move_forward.js",
    "tutorial:07": "bun src/tutorials/07_goto_waypoint.js",
    "postinstall": "cd ../../panels-standalone/packages/tensorfleet-util && bun run build"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "jpeg-js": "^0.4.4",
    "js-yaml": "^4.1.0",
    "onnxruntime-node": "^1.18.0",
    "roslib": "^1.3.0",
    "tensorfleet-util": "file:../../panels-standalone/packages/tensorfleet-util",
    "ws": "^8.18.0"
  }
}
