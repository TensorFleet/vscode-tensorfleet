#
# TensorFleet Drone JS - Environment Example
#
# Copy this file to ".env" and adjust values as needed.
#

# TensorFleet-managed values (updated automatically on login/region/VM changes)
TENSORFLEET_REGION=
TENSORFLEET_VM_MANAGER_URL=
TENSORFLEET_PROXY_URL=
TENSORFLEET_NODE_ID=
TENSORFLEET_JWT=

# ROS bridge connection (auto-populated when a VM is running)
ROSBRIDGE_URL=
ROSBRIDGE_PORT=9091
R2B_HOST=
R2B_PORT=9091

# Optional frame id override for setpoints and velocity commands.
SETPOINT_FRAME_ID=map
