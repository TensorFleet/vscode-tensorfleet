#
# TensorFleet LeRobot Arm - Environment Example
#
# Copy this file to ".env" and adjust values as needed.
#

# Primary TensorFleet connection (everything else is derived automatically).
TENSORFLEET_BASE_URL=
TENSORFLEET_JWT=

# SO101 Robot Configuration
# Set these values to avoid typing long command-line arguments each time.
# Find your ports using: lerobot-find-port
SO101_LEADER_PORT=/dev/tty.usbmodem58760431551
SO101_LEADER_ID=my_awesome_leader_arm
SO101_LEADER_CALIBRATION_DIR=~/.cache/huggingface/lerobot/calibration/teleoperators/so_leader/
# Follower env vars are opt-in; pass --use-follower-env or --follower-port.
SO101_FOLLOWER_PORT=/dev/tty.usbmodem58760431552
SO101_FOLLOWER_ID=my_awesome_follower_arm
SO101_FOLLOWER_CALIBRATION_DIR=~/.cache/huggingface/lerobot/calibration/robots/so_follower/
