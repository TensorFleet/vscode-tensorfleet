#
# TensorFleet Simple Robot Python - Environment Example
#
# Copy this file to ".env" and adjust values as needed.
#

# Primary TensorFleet connection (managed by the VS Code extension).
TENSORFLEET_BASE_URL=
TENSORFLEET_JWT=

# Direct rosbridge connection overrides (optional).
ROS_HOST=172.16.0.10
ROS_PORT=9091
ROSBRIDGE_URL=

# Topic overrides
CMD_VEL_TOPIC=/cmd_vel_raw
SCAN_TOPIC=/scan
IMAGE_TOPIC=/camera/image_raw

# Motion tuning
LINEAR_SPEED=0.2
ANGULAR_SPEED=0.5
